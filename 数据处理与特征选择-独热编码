import pandas as pd
import numpy as np

# 读取Excel文件，指定时间列（timestamp）作为索引，并将其解析为日期格式
file_path = r'C:\Users\Admin\Desktop\特征工程数据集.xlsx'  # 文件路径
df = pd.read_excel(file_path, parse_dates=['timestamp'], index_col='timestamp')

# 根据功率值的范围进行分类
conditions = [
    (df['Active_Power'] < 1),
    (df['Active_Power'] >= 1) & (df['Active_Power'] < 3),
    (df['Active_Power'] >= 3) & (df['Active_Power'] < 4),
    (df['Active_Power'] >= 4)
]

# 对应的编码值
encoded_values = ['0001', '0010', '0100', '1000']

# 使用np.select()根据条件生成编码
df['功率编码'] = np.select(conditions, encoded_values, default='未知')

# 将结果保存到源文件的第三列
df.to_excel(r'C:\Users\Admin\Desktop\处理后的数据.xlsx')

