import pandas as pd
import numpy as np

# 读取CSV文件，指定时间列（timestamp）作为索引，并将其解析为日期格式
file_path = r'C:\Users\Admin\Desktop\85-Site_DKA-M7_A-Phase.csv'  # 文件路径
df = pd.read_csv(file_path, parse_dates=['timestamp'], index_col='timestamp')

# 提取日期信息
df['日期'] = df.index.date

# 按日期分组
grouped = df.groupby('日期')

# 获取日期列表，并转换为列表类型
dates = list(grouped.groups.keys())

# 按比例划分数据集：70% 训练集，15% 验证集，15% 测试集
train_size = int(len(dates) * 0.7)
val_size = int(len(dates) * 0.15)

# 划分日期
train_dates = dates[:train_size]
val_dates = dates[train_size:train_size + val_size]
test_dates = dates[train_size + val_size:]

# 提取训练集、验证集和测试集数据
train_data = df[df['日期'].isin(train_dates)]
val_data = df[df['日期'].isin(val_dates)]
test_data = df[df['日期'].isin(test_dates)]

# 显示划分后的数据集的大小
print(f"训练集大小: {train_data.shape}")
print(f"验证集大小: {val_data.shape}")
print(f"测试集大小: {test_data.shape}")

# 你也可以将数据保存为不同的CSV文件
train_data.to_csv(r'C:\Users\Admin\Desktop\train_data.csv')
val_data.to_csv(r'C:\Users\Admin\Desktop\val_data.csv')
test_data.to_csv(r'C:\Users\Admin\Desktop\test_data.csv')
