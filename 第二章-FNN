import pandas as pd
import matplotlib.pyplot as plt
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
import numpy as np
import time

# 设置 Matplotlib 字体
plt.rcParams['font.sans-serif'] = ['Microsoft YaHei']  # 使用微软雅黑
plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题

# 加载数据集
file_path = "C:\\Users\\Admin\\Desktop\\预测数据集.xlsx"
sheet_name = '85-Site_DKA-M7_A-Phase'
df = pd.read_excel(file_path, sheet_name=sheet_name)

# 确保数据按时间排序
df = df.sort_values(by='timestamp')

# 仅使用 Active_Power 作为特征
data = df[['Active_Power']].values

# 归一化数据
scaler = MinMaxScaler()
data = scaler.fit_transform(data)

# 创建 FNN 数据集
def create_sequences(data, seq_length):
    sequences = []
    labels = []
    for i in range(len(data) - seq_length):
        sequences.append(data[i:i+seq_length].flatten())  # 展平数据用于 FNN
        labels.append(data[i+seq_length])
    return torch.tensor(sequences, dtype=torch.float32), torch.tensor(labels, dtype=torch.float32)

# 定义序列长度
seq_length = 10
X, y = create_sequences(data, seq_length)

# 划分训练集和测试集
train_size = int(len(X) * 0.8)
X_train, X_test = X[:train_size], X[train_size:]
y_train, y_test = y[:train_size], y[train_size:]

# 定义 FNN 模型
class FNNModel(nn.Module):
    def __init__(self, input_size=seq_length, hidden_size=64, output_size=1):
        super(FNNModel, self).__init__()
        self.fc1 = nn.Linear(input_size, hidden_size)
        self.fc2 = nn.Linear(hidden_size, hidden_size)
        self.fc3 = nn.Linear(hidden_size, output_size)
        self.relu = nn.ReLU()
    
    def forward(self, x):
        x = self.relu(self.fc1(x))
        x = self.relu(self.fc2(x))
        x = self.fc3(x)
        return x

# 初始化模型
model = FNNModel()
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

# 记录训练开始时间
start_time = time.time()

# 训练模型
epochs = 500
loss_history = []  # 记录损失变化
for epoch in range(epochs):
    model.train()
    optimizer.zero_grad()
    output = model(X_train)
    loss = criterion(output, y_train)
    loss.backward()
    optimizer.step()
    loss_history.append(loss.item())  # 记录损失
    if (epoch+1) % 10 == 0:
        print(f"Epoch [{epoch+1}/{epochs}], Loss: {loss.item():.6f}")

# 记录训练结束时间
end_time = time.time()
training_time = end_time - start_time
print(f"模型训练总耗时: {training_time:.2f} 秒")

# 绘制损失变化
plt.figure(figsize=(8, 5))
plt.plot(range(1, epochs+1), loss_history, marker='o', linestyle='-', label='训练损失')
plt.xlabel("训练轮数")
plt.ylabel("损失值")
plt.title("FNN 训练损失变化趋势")
plt.legend()
plt.grid()
plt.savefig("C:\\Users\\Admin\\Desktop\\FNN训练损失.svg", format='svg', bbox_inches='tight')
plt.show()

print("训练损失变化图已保存至: C:\\Users\\Admin\\Desktop\\FNN训练损失.svg")

# 进行预测
model.eval()
predicted = model(X_test).detach().numpy()
predicted = scaler.inverse_transform(predicted)
y_test_actual = np.nan_to_num(scaler.inverse_transform(y_test.numpy().reshape(-1, 1)))

# 计算误差指标
mae = mean_absolute_error(y_test_actual, predicted)
rmse = np.sqrt(mean_squared_error(y_test_actual, predicted))
r2 = r2_score(y_test_actual, predicted)

print(f"平均绝对误差 (MAE): {mae}")
print(f"均方根误差 (RMSE): {rmse}")
print(f"决定系数 (R²): {r2}")

# 绘制真实值与预测值对比图
plt.figure(figsize=(10, 5))
plt.plot(df['timestamp'].iloc[train_size + seq_length:], y_test_actual, label='真实功率', linestyle='-', marker='o', markersize=3)
plt.plot(df['timestamp'].iloc[train_size + seq_length:], predicted, label='预测功率', linestyle='--', marker='s', markersize=3)
plt.xlabel("时间")
plt.ylabel("功率 (kW)")
plt.legend(loc='lower center', bbox_to_anchor=(0.5, -0.25), ncol=2)

# 保存为矢量图（SVG 格式）
output_path = "C:\\Users\\Admin\\Desktop\\FNN预测结果.svg"
plt.savefig(output_path, format='svg', bbox_inches='tight')
plt.show()
