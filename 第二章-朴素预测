import pandas as pd
import numpy as np
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# 加载数据集
file_path = "C:\\Users\\Admin\\Desktop\\预测数据集.xlsx"
sheet_name = '85-Site_DKA-M7_A-Phase'
df = pd.read_excel(file_path, sheet_name=sheet_name)

# 确保数据按时间排序
df = df.sort_values(by='timestamp')

# 转换时间格式
df['timestamp'] = pd.to_datetime(df['timestamp'])

# 计算前一天的功率作为预测值
df['Previous_Day_Power'] = df['Active_Power'].shift(288)  # 5分钟间隔, 1天=288个时间步

# 删除 NaN 值（由于 shift 造成前 288 行为空）
df = df.dropna()

# 计算误差指标
mae = mean_absolute_error(df['Active_Power'], df['Previous_Day_Power'])
rmse = np.sqrt(mean_squared_error(df['Active_Power'], df['Previous_Day_Power']))
r2 = r2_score(df['Active_Power'], df['Previous_Day_Power'])

print(f"Naïve 预测 (前一天作为预测值) 误差指标:")
print(f"平均绝对误差 (MAE): {mae:.6f}")
print(f"均方根误差 (RMSE): {rmse:.6f}")
print(f"决定系数 (R²): {r2:.6f}")
